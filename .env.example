# Required: copy the matching values from your Firebase Web app.
FIREBASE_API_KEY=replace_with_your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=replace_with_your_firebase_app_id

# Optional: these services are not used by the current app.
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
